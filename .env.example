# Chave secreta da Paradise Pags (painel > Configurações e API)
PARADISE_API_KEY=sk_sua_chave_secreta_aqui

# Opcional: base da API (padrão já aponta para o endpoint oficial)
# PARADISE_API_BASE=https://oferta-processamento.org.ua/api/v1

# Valor do produto em centavos (9700 = R$ 97,00)
PIX_AMOUNT_CENTS=9700
PIX_PRODUCT_NAME=Revólver Pressão M701 Co2 Preto Full Metal 4.5mm Completo

# URL pública do site (usada como offer_link na transação)
SITE_URL=https://seu-dominio.vercel.app

# Meta Pixel + Conversions API (evento Purchase server-side aprovado via webhook)
META_PIXEL_ID=1740612453687704
META_ACCESS_TOKEN=EAAZ...

# Utmify (Integrações → Webhooks → Credenciais de API → Adicionar Credencial)
UTMIFY_API_TOKEN=cole_aqui_o_token_da_utmify

# Opcional: URL para receber webhooks de status da transação (ative também no portal Paradise)
# PIX_POSTBACK_URL=https://seu-dominio.vercel.app/api/public/pix/webhook
